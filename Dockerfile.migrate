# Runtime image for the one-shot migration runner — pre-built for the build platform.
FROM debian:bookworm-slim
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY bin/${TARGETARCH}/meridian-migrate /usr/local/bin/meridian-migrate
ENTRYPOINT ["/usr/local/bin/meridian-migrate"]
