# Meridian production stack — environment template for docker-compose.yml.
#
#   cp .env.docker.example .env      # then replace EVERY placeholder below
#
# `.env` is git-ignored. Never commit real secrets. docker-compose reads this
# file automatically and constructs the derived connection URLs from these
# primitives, so you only set each secret once here.
#
# Generate strong values:
#   openssl rand -hex 32     # passwords
#   openssl rand -hex 64     # MERIDIAN_AUTH_SECRET (>= 64 chars, required)

# --- PostgreSQL superuser (created by the postgres image; also PgBouncer's auth_user) ---
POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# --- Least-privilege database roles (created on first init by 01-provision.sh) ---
# The app runs as meridian_app; migrations run as meridian_migrator.
MERIDIAN_OWNER_PASSWORD=replace-with-openssl-rand-hex-32
MERIDIAN_MIGRATOR_PASSWORD=replace-with-openssl-rand-hex-32
MERIDIAN_APP_PASSWORD=replace-with-openssl-rand-hex-32
MERIDIAN_WORKER_PASSWORD=replace-with-openssl-rand-hex-32
MERIDIAN_READONLY_PASSWORD=replace-with-openssl-rand-hex-32

# --- Application auth secret (JWT signing). Must be at least 64 characters. ---
MERIDIAN_AUTH_SECRET=replace-with-openssl-rand-hex-64

# --- RustFS / S3-compatible object storage ---
# These credentials are reused as S3_ACCESS_KEY_ID / MEDIA_S3_ACCESS_KEY etc.
RUSTFS_ROOT_USER=meridian
RUSTFS_ROOT_PASSWORD=replace-with-openssl-rand-hex-32
S3_REGION=us-east-1
# Platform probe bucket and owned-media bucket (may be the same or different).
S3_BUCKET=meridian-media
MEDIA_S3_BUCKET=meridian-media

# --- App runtime ---
# Host port the web UI/API is published on (container always listens on 3100).
APP_PORT=3100
RUST_LOG=meridian=info,tower_http=info
# Expose password-reset tokens in API responses — DEVELOPMENT ONLY. Keep false.
MERIDIAN_EXPOSE_RESET_TOKENS=false

# --- Build metadata (optional) ---
# Embedded into /build-info; set at build time. e.g. GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=
